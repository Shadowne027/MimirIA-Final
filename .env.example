# ===== Variables de entorno (Vercel → Settings → Environment Variables) =====

# --- Obligatorias ---

# MongoDB Atlas — cadena de conexión del cluster (Database → Connect → Drivers)
# Ejemplo: mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# OpenAI — clave con acceso a gpt-5-mini y gpt-5-nano (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Secreto para firmar los tokens de sesión. OBLIGATORIO y de mínimo 32 caracteres:
# sin él el servidor se niega a iniciar sesiones (ya no existe un valor por defecto).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# --- Opcionales ---

# Orígenes extra autorizados por CORS, separados por coma. Por defecto sólo
# https://mimiria.vercel.app. Las peticiones del mismo dominio no lo necesitan.
# ALLOWED_ORIGINS=https://mimiria.vercel.app,https://mi-dominio.edu.co

# Clave para ver el detalle técnico en /api/health?key=TU_CLAVE (mínimo 16 caracteres).
# Sin ella, /api/health solo muestra mensajes genéricos (no filtra claves ni servidores).
# HEALTH_DEBUG_KEY=

# Mensajes máximos por estudiante (protegen tu saldo de OpenAI). Por defecto 30/hora y 150/día.
# CHAT_LIMIT_HOUR=30
# CHAT_LIMIT_DAY=150
